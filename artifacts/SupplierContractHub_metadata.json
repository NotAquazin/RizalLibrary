		"devdoc": {
			"kind": "dev",
			"methods": {
				"addDiscount(uint256,uint256)": {
					"params": {
						"_discount": "the whole number percentage of the discount",
						"_minimumCost": "the minimum total cost to avail the discount"
					}
				},
				"addStock(string,int256,uint256)": {
					"details": "checks if ingredient is already part of the listed stocks, if not add it to do the list of ingredients.",
					"params": {
						"_ingredient": "the ingredient name to be added.",
						"_price": "the unit price of an ingredient.",
						"_qty": "the quantity of an ingredient to be added."
					}
				},
				"addSupplier(string,uint256,uint256)": {
					"details": "supplier address is added to the list of supplier addresses",
					"params": {
						"_contractDuration": "is the length of a contracts validity",
						"_name": "is the name of the supplier",
						"_terminationPenalty": "is the penalty fee for terminating the contract"
					}
				},
				"getIngredientQty(address,string)": {
					"params": {
						"_ingredient": "the ingredient of which's quantity is to be retrieved.",
						"_supplier": "the address of the supplier."
					},
					"returns": {
						"_0": "qty of the ingredient in stock."
					}
				},
				"getIngredientStockDetails(address,string)": {
					"details": "This is used in addIngredient() function in the child contract",
					"params": {
						"_ingredient": "The ingredient that needs to be searched",
						"_supplier": "The address of the supplier"
					},
					"returns": {
						"_0": "ingredient The name of the ingredient",
						"_1": "qty The quantity of the ingredient",
						"_2": "price The price of the ingredient"
					}
				},
				"getPrice(address,string)": {
					"params": {
						"_ingredient": "the ingredient of which's price to be retrieved.",
						"_supplier": "the address of the supplier"
					},
					"returns": {
						"_0": "uint price of the ingredient."
					}
				},
				"getSupplierIngredientsList(address)": {
					"details": "This is used in addIngredient() function in the child contract",
					"params": {
						"_supplier": "The address of the supplier"
					},
					"returns": {
						"_0": "ingredientsList of the supplier"
					}
				},
				"getSupplierPenalty(address)": {
					"params": {
						"_supplier": "the address of the supplier"
					},
					"returns": {
						"penalty": "the uint of how much the termination penalty of a supplier's associated contracts are."
					}
				},
				"reduceStock(string,int256)": {
					"details": "can only be called by the supplier on their own stock",
					"params": {
						"_ingredient": "the ingredient to be reduced in quantity.",
						"_reduceQty": "the number to reduce in the ingredient's quantity."
					}
				},
				"selectSupplier(address,string)": {
					"details": "Adds the contract address to the list of authorized child contracts.",
					"params": {
						"_restaurantName": "the name of the restaurant who selects the supplier.",
						"_supplierAddress": "the address of the selected supplier."
					}
				},
				"stockSold(address,string,int256)": {
					"details": "can only be called by the a child contract when order is made.",
					"params": {
						"_ingredient": "the ingredient to be reduced in quantity.",
						"_reduceQty": "the number to reduce in the ingredient's quantity."
					}
				},
				"viewContracts()": {
					"returns": {
						"_0": "RestaurantContracts an array of RestaurantContracts structs."
					}
				},
				"viewDiscount(address)": {
					"params": {
						"_supplierAddress": "the address of the supplier of which discounts' are to be viewed."
					},
					"returns": {
						"_0": "Discount array of Discount structs"
					}
				},
				"viewSupplierStock(address)": {
					"params": {
						"_supplierAddress": "the address of the supplier."
					},
					"returns": {
						"_0": "stockSummary an array of Stock structs."
					}
				},
				"viewSuppliers()": {
					"returns": {
						"_0": "summaries an arry of SupplierSummary structs"
					}
				}
			},
